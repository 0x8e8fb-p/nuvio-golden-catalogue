# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# On Vercel, set these under Project > Settings > Environment Variables, then
# redeploy (changes only apply to new deployments).
# ---------------------------------------------------------------------------

# REQUIRED. Your TMDB API key: the v3 "API Key" (32 hex characters), not the
# long "API Read Access Token". Get one free at
# https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OPTIONAL. Country of the default edition served at /manifest.json and
# /collections.json (default US). Every country also has /r/<CC>/manifest.json.
DEFAULT_REGION=IN

# OPTIONAL. Public origin written into artwork and pack URLs, for a custom
# domain or a proxy, e.g. https://tv.example.org. By default the request's own
# host is used.
PUBLIC_BASE_URL=

# OPTIONAL. Trust X-Forwarded-Host and X-Forwarded-Proto from a proxy in front
# of a self-hosted server (set to 1). Vercel is detected automatically.
TRUST_PROXY=

# OPTIONAL. Secret for signing item artwork URLs (title tiles, Top 10 tiles,
# title logos). Defaults to a value derived from TMDB_API_KEY; on Vercel with
# neither set, a random key per instance is used. Changing it invalidates item
# art URLs issued before the change. Folder art is not signed.
ART_SECRET=

# OPTIONAL. Set to "posters" to turn off generated title tiles, Top 10 tiles
# and title logos (rows then use plain TMDB images). Folder art is unaffected.
ART_MODE=

# OPTIONAL. Language for TMDB metadata (default en-US).
TMDB_LANGUAGE=en-US

# OPTIONAL. Rating Poster Database key: rating badges on portrait posters
# (search results). Leave blank to disable.
RPDB_API_KEY=

# OPTIONAL. fanart.tv personal API key: clearlogos on detail pages.
FANART_API_KEY=

# OPTIONAL. Set to 1 to add AniList genres and scores to anime detail pages.
ENABLE_ANILIST=

# OPTIONAL. Port for local development (default 7000).
PORT=7000

# OPTIONAL. Other TMDB hosts, for a mirror or a mock. If api.themoviedb.org is
# blocked on your network (some Indian ISPs), https://api.tmdb.org/3 works.
TMDB_API_BASE=
TMDB_IMAGE_BASE=

# OPTIONAL. Countries checked by `npm run ping:tmdb` (default IN,US).
PING_REGIONS=
