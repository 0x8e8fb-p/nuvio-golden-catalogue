# ---------------------------------------------------------------------------
# Copy this file to `.env` and fill in your own values. NEVER commit `.env`.
# ---------------------------------------------------------------------------

# REQUIRED. Your TMDB API key (v3 "API Key", not the v4 read token).
# Get one free at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# OPTIONAL. Language for TMDB metadata (default en-US).
TMDB_LANGUAGE=en-US

# OPTIONAL. Rating Poster Database key — overlays rating badges onto posters.
# Free-tier keys exist, e.g. t0-free-rpdb (see README). Leave blank to disable.
RPDB_API_KEY=

# OPTIONAL. fanart.tv personal API key — adds transparent clearlogos to detail
# pages. Leave blank to disable; the addon falls back to TMDB/Cinemeta logos.
FANART_API_KEY=

# OPTIONAL. Port for local development (default 7000).
PORT=7000

# OPTIONAL. Set to 1 to enrich anime detail pages with AniList data (scores,
# extra genres). No API key needed. Adds a network hop per anime detail open.
ENABLE_ANILIST=
