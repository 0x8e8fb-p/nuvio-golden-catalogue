      "group": "Spotlight",
      "art": "rank",
      "limit": 10,
      "pageSize": 10,
      "source": {
        "mix": [
          { "endpoint": "/trending/movie/day", "params": {}, "weightBy": { "IN": 1, "_default": 2 } },
          { "endpoint": "/discover/movie", "params": { "with_original_language": "hi|te|ta|ml|kn", "primary_release_date.gte": "{{now-120d}}", "primary_release_date.lte": "{{now}}", "sort_by": "popularity.desc", "vote_count.gte": 3 }, "weightBy": { "IN": 1, "_default": 0 } }
